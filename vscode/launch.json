{
  "version": "0.2.0",
  "configurations": [
    // --- RUST (Cargo) ---
    // Requiere la extensión "vadimcn.vscode-lldb"
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug Rust",
      "cargo": {
        "args": ["build"]
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    },

    // --- PYTHON (FastAPI) ---
    {
      "name": "Python: FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["main:app", "--reload"],
      "jinja": true,
      "justMyCode": true,
      "cwd": "${workspaceFolder}"
    },

    // --- PYTHON (Flask) ---
    {
      "name": "Python: Flask",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "env": {
        "FLASK_APP": "app.py",
        "FLASK_DEBUG": "1"
      },
      "args": ["run", "--no-debugger", "--no-reload"],
      "jinja": true,
      "justMyCode": true,
      "cwd": "${workspaceFolder}"
    },

    // --- NODE.JS (Express / Script) ---
    {
      "type": "node",
      "request": "launch",
      "name": "Node: Run Index",
      "program": "${workspaceFolder}/index.js", // Cambia esto por tu archivo de entrada (ej: src/main.js o server.js)
      "restart": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },

    // --- VITE / REACT (Chrome Debug) ---
    // Requiere arrancar el server de Vite primero (ej: npm run dev)
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome against localhost",
      "url": "http://localhost:5173", // Puerto por defecto de Vite
      "webRoot": "${workspaceFolder}"
    },

    // --- JAVA (Spring Boot) ---
    {
      "type": "java",
      "name": "Spring Boot Launch",
      "request": "launch",
      "mainClass": "", // Se suele autocompletar si usas las extensiones de Java
      "projectName": "",
      "args": "",
      "cwd": "${workspaceFolder}"
    }
  ]
}
